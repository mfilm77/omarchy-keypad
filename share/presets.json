{
  "schemaVersion": 1,
  "_comment": "Ready-made commands offered in the editor's command mode. Labels and commands follow Omarchy's own binding files (/usr/share/omarchy/default/hypr/bindings/*.lua) so they read the way the rest of the desktop does. Picking one fills the fields in; it never locks them.",
  "presets": [
    { "category": "Menus", "label": "Omarchy menu", "run": "omarchy-menu toggle" },
    { "category": "Menus", "label": "Apps menu", "run": "omarchy-menu toggle apps" },
    { "category": "Menus", "label": "Capture menu", "run": "omarchy-menu toggle capture" },
    { "category": "Menus", "label": "Toggle menu", "run": "omarchy-menu toggle toggle" },
    { "category": "Menus", "label": "Hardware menu", "run": "omarchy-menu toggle hardware" },
    { "category": "Menus", "label": "System menu", "run": "omarchy-menu toggle system" },
    { "category": "Menus", "label": "Share", "run": "omarchy-menu toggle share" },
    { "category": "Menus", "label": "Theme menu", "run": "omarchy-menu toggle theme" },
    { "category": "Menus", "label": "Background switcher", "run": "omarchy-menu toggle background" },
    { "category": "Menus", "label": "Set reminder", "run": "omarchy-menu toggle reminder-set" },
    { "category": "Menus", "label": "Keybindings", "run": "omarchy-menu-keybindings" },
    { "category": "Menus", "label": "File menu", "run": "omarchy-menu-file" },
    { "category": "Menus", "label": "Emojis", "run": "omarchy-shell shell toggle omarchy.emojis" },
    { "category": "Menus", "label": "Clipboard manager", "run": "omarchy-shell shell toggle omarchy.clipboard" },
    { "category": "Menus", "label": "Calculator", "run": "omacalc" },

    { "category": "Capture", "label": "Screenshot", "run": "omarchy-capture-screenshot" },
    { "category": "Capture", "label": "Screenshot a region", "run": "omarchy-capture-region" },
    { "category": "Capture", "label": "Screen recording (start / stop)", "run": "omarchy-capture-screenrecording --stop-recording || omarchy-menu toggle trigger.capture.screenrecord" },
    { "category": "Capture", "label": "Extract text (OCR) from screenshot", "run": "omarchy-capture-text" },
    { "category": "Capture", "label": "Read a QR code on screen", "run": "omarchy-capture-qr" },
    { "category": "Capture", "label": "Colour picker", "run": "pkill hyprpicker || hyprpicker -a" },
    { "category": "Capture", "label": "Transcode", "run": "omarchy-transcode" },

    { "category": "Dictation", "label": "Toggle dictation", "run": "voxtype record toggle" },
    { "category": "Dictation", "label": "Cancel dictation", "run": "voxtype record cancel" },

    { "category": "Sound", "label": "Volume up", "run": "omarchy-audio-output-volume raise" },
    { "category": "Sound", "label": "Volume down", "run": "omarchy-audio-output-volume lower" },
    { "category": "Sound", "label": "Mute", "run": "omarchy-audio-output-volume mute-toggle" },
    { "category": "Sound", "label": "Mute microphone", "run": "omarchy-audio-input-mute" },
    { "category": "Sound", "label": "Switch audio output", "run": "omarchy-audio-output-switch" },
    { "category": "Sound", "label": "Switch media source", "run": "omarchy-audio-source-switch" },
    { "category": "Sound", "label": "Play / pause", "run": "omarchy-shell media playPause" },
    { "category": "Sound", "label": "Pause everything (and resume it)", "run": "keypad-media-pause-all" },
    { "category": "Sound", "label": "Next track", "run": "omarchy-shell media next" },
    { "category": "Sound", "label": "Previous track", "run": "omarchy-shell media previous" },

    { "category": "Notifications", "label": "Dismiss last notification", "run": "omarchy-shell notifications dismissOne" },
    { "category": "Notifications", "label": "Dismiss all notifications", "run": "omarchy-shell notifications dismissAll" },
    { "category": "Notifications", "label": "Invoke last notification", "run": "omarchy-shell notifications invokeLast" },
    { "category": "Notifications", "label": "Notification history", "run": "omarchy-shell notifications showHistory" },

    { "category": "Windows", "label": "Close window", "run": "hyprctl dispatch 'hl.dsp.window.close()'" },
    { "category": "Windows", "label": "Full screen", "run": "hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = \"fullscreen\" })'" },
    { "category": "Windows", "label": "Full width", "run": "hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = \"maximized\" })'" },
    { "category": "Windows", "label": "Toggle floating / tiling", "run": "hyprctl dispatch 'hl.dsp.window.float({ action = \"toggle\" })'" },
    { "category": "Windows", "label": "Toggle window split", "run": "hyprctl dispatch 'hl.dsp.layout(\"togglesplit\")'" },
    { "category": "Windows", "label": "Toggle window grouping", "run": "hyprctl dispatch 'hl.dsp.group.toggle()'" },
    { "category": "Windows", "label": "Focus next window", "run": "hyprctl dispatch 'hl.dsp.window.cycle_next()'" },
    { "category": "Windows", "label": "Focus previous window", "run": "hyprctl dispatch 'hl.dsp.window.cycle_next({ next = false })'" },
    { "category": "Windows", "label": "Focus the window on the left", "run": "hyprctl dispatch 'hl.dsp.focus({ direction = \"l\" })'" },
    { "category": "Windows", "label": "Focus the window on the right", "run": "hyprctl dispatch 'hl.dsp.focus({ direction = \"r\" })'" },
    { "category": "Windows", "label": "Focus the window above", "run": "hyprctl dispatch 'hl.dsp.focus({ direction = \"u\" })'" },
    { "category": "Windows", "label": "Focus the window below", "run": "hyprctl dispatch 'hl.dsp.focus({ direction = \"d\" })'" },
    { "category": "Windows", "label": "Tiled full screen", "run": "omarchy-hyprland-window-tiled-fullscreen-toggle" },
    { "category": "Windows", "label": "Pop window out (float & pin)", "run": "omarchy-hyprland-window-pop" },
    { "category": "Windows", "label": "Toggle window transparency", "run": "omarchy-hyprland-window-transparency-toggle" },
    { "category": "Windows", "label": "Toggle window gaps", "run": "omarchy-hyprland-window-gaps-toggle" },
    { "category": "Windows", "label": "Save window width", "run": "omarchy-hyprland-window-width save" },
    { "category": "Windows", "label": "Restore window width", "run": "omarchy-hyprland-window-width restore" },
    { "category": "Windows", "label": "Close all windows", "run": "omarchy-hyprland-window-close-all" },

    { "category": "Workspaces", "label": "Workspace 1", "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })'" },
    { "category": "Workspaces", "label": "Workspace 2", "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })'" },
    { "category": "Workspaces", "label": "Workspace 3", "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })'" },
    { "category": "Workspaces", "label": "Workspace 4", "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })'" },
    { "category": "Workspaces", "label": "Next workspace", "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    { "category": "Workspaces", "label": "Previous workspace", "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'" },
    { "category": "Workspaces", "label": "Former workspace", "run": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"previous\" })'" },
    { "category": "Workspaces", "label": "Move window to the next workspace", "run": "hyprctl dispatch 'hl.dsp.window.move({ workspace = \"e+1\" })'" },
    { "category": "Workspaces", "label": "Toggle scratchpad", "run": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"scratchpad\")'" },
    { "category": "Workspaces", "label": "Move window to scratchpad", "run": "hyprctl dispatch 'hl.dsp.window.move({ workspace = \"special:scratchpad\", follow = false })'" },
    { "category": "Workspaces", "label": "Toggle workspace layout", "run": "omarchy-hyprland-workspace-layout-toggle" },

    { "category": "Apps", "label": "Terminal", "run": "omarchy-launch-terminal" },
    { "category": "Apps", "label": "Browser", "run": "omarchy-launch-browser" },
    { "category": "Apps", "label": "Browser (private)", "run": "omarchy-launch-browser --private" },
    { "category": "Apps", "label": "File manager", "run": "omarchy-launch-nautilus" },
    { "category": "Apps", "label": "File manager (current folder)", "run": "omarchy-launch-nautilus-cwd" },
    { "category": "Apps", "label": "Editor", "run": "omarchy-launch-editor" },
    { "category": "Apps", "label": "Docker TUI", "run": "omarchy-launch-docker-tui" },
    { "category": "Apps", "label": "About this machine", "run": "omarchy-launch-about" },

    { "category": "System", "label": "Lock screen", "run": "omarchy-system-lock" },
    { "category": "System", "label": "Sleep", "run": "omarchy-system-sleep-lock" },
    { "category": "System", "label": "Screensaver", "run": "omarchy-launch-screensaver" },
    { "category": "System", "label": "Toggle top bar", "run": "omarchy-toggle bar" },
    { "category": "System", "label": "Toggle nightlight", "run": "omarchy-toggle nightlight" },
    { "category": "System", "label": "Toggle locking on idle", "run": "omarchy-toggle idle" },
    { "category": "System", "label": "Toggle silencing notifications", "run": "omarchy-toggle notification-silencing" },
    { "category": "System", "label": "Brightness up", "run": "omarchy-brightness-display +5%" },
    { "category": "System", "label": "Brightness down", "run": "omarchy-brightness-display 5%-" },
    { "category": "System", "label": "Theme switcher", "run": "omarchy-theme-switcher" },
    { "category": "System", "label": "Next background", "run": "omarchy-theme-bg-next" },
    { "category": "System", "label": "Keyboard backlight cycle", "run": "omarchy-brightness-keyboard cycle" },
    { "category": "System", "label": "Toggle touchpad", "run": "omarchy-toggle touchpad" },
    { "category": "System", "label": "Toggle laptop display", "run": "omarchy-hyprland-monitor-internal toggle" }
  ]
}
